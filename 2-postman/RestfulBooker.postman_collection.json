{
  "info": {
    "name": "Restful-Booker API Tests",
    "description": "Functional API test suite for https://restful-booker.herokuapp.com. Run folders 0-5 in order (they share state). Folder 6 is data-driven. Folder 7 documents known defects and is expected to fail.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Ping - service is up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 (API returns 201 for ping)', () => pm.response.to.have.status(201));",
                  "pm.test('Response time < 2000 ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            }
          }
        }
      ]
    },
