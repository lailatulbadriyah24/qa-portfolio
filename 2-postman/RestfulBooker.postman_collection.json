    {
      "name": "2. Booking - Create",
      "item": [
        {
          "name": "TC-CRT-01 Create booking with valid data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('bookingid is returned', () => pm.expect(body.bookingid).to.be.a('number'));",
                  "pm.test('Response echoes the request data', () => {",
                  "  pm.expect(body.booking.firstname).to.eql('Laila');",
                  "  pm.expect(body.booking.totalprice).to.eql(150);",
                  "  pm.expect(body.booking.bookingdates.checkin).to.eql('2026-11-01');",
                  "});",
                  "pm.test('Booking matches schema', () => pm.response.to.have.jsonSchema({ type: 'object', properties: { booking: {\"type\":\"object\",\"required\":[\"firstname\",\"lastname\",\"totalprice\",\"depositpaid\",\"bookingdates\"],\"properties\":{\"firstname\":{\"type\":\"string\"},\"lastname\":{\"type\":\"string\"},\"totalprice\":{\"type\":\"number\"},\"depositpaid\":{\"type\":\"boolean\"},\"bookingdates\":{\"type\":\"object\",\"required\":[\"checkin\",\"checkout\"],\"properties\":{\"checkin\":{\"type\":\"string\"},\"checkout\":{\"type\":\"string\"}}},\"additionalneeds\":{\"type\":\"string\"}}} } }));",
                  "pm.collectionVariables.set('bookingId', body.bookingid);",
                  "pm.test('Response time < 2000 ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Laila\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-01\",\n    \"checkout\": \"2026-11-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
