    {
      "name": "6. Data-driven - Create booking from CSV",
      "item": [
        {
          "name": "TC-DD-01 Create booking for each CSV row",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Build the payload from the CSV row (run with: newman run ... -d data/bookings.csv --folder \"6. Data-driven ...\")",
                  "const d = pm.iterationData;",
                  "const payload = {",
                  "  firstname: d.get('firstname') || 'Default',",
                  "  lastname: d.get('lastname') || 'Tester',",
                  "  totalprice: Number(d.get('totalprice') || 100),",
                  "  depositpaid: String(d.get('depositpaid')) === 'true',",
                  "  bookingdates: { checkin: d.get('checkin') || '2026-11-01', checkout: d.get('checkout') || '2026-11-02' },",
                  "};",
                  "pm.variables.set('payload', JSON.stringify(payload));",
                  "pm.variables.set('expectedFirstname', payload.firstname);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Created booking echoes CSV data', () => pm.expect(pm.response.json().booking.firstname).to.eql(pm.variables.get('expectedFirstname')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
